[Unit]
Description=Pisound Micro GPIO to MIDI bridge with debounce
BindsTo=pitcher-modep-midi.service
After=sound.target pisound-micro-mapper.service pitcher-modep-midi.service
Conflicts=pisound-micro-mapper.service

[Service]
Type=simple
User=lezart
SupplementaryGroups=gpio audio
Environment=PYTHONUNBUFFERED=1
Environment=MIDI_OUTPUT_PORT=Lezart-Buttons-MODEP:Lezart-Buttons-MODEP
ExecStart=/usr/bin/python3 /usr/local/bin/pitcher-modep-buttons
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
